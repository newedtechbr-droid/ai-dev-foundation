{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-dev-foundation",
  "compatibility_date": "2026-11-17",
  "main": "worker/index.js",
  "assets": {
    "directory": "./landing",
    "binding": "ASSETS",
    "run_worker_first": ["/videos/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "viverdecoliving.com.br", "custom_domain": true },
    { "pattern": "www.viverdecoliving.com.br", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false
}
